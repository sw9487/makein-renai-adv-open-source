# API 端點（例如：https://api.openai.com/v1）。
AI_API_URL=

# API 金鑰。
AI_API_KEY=

# 預設模型名稱（例如：gpt-4o-mini、qwen2.5-72b-instruct 等）。
AI_MODEL=

DATABASE_URL=postgresql://admin:105114@localhost:5438/MAKEIN_DB
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=makein-s3
S3_ACCESS_KEY=makein
S3_SECRET_KEY=makein
S3_REGION=auto

# 本機資料位置可透過 CLI --data-dir 或 MAKEIN_DATA_DIR 環境變數指定。
# 預設 ~/.makein-renai-adv；遊戲埠預設9487。

# Optional image plugin (disabled by default). Set a local or remote A1111-compatible base URL.
SD_ENABLED=false
SD_AUTO_STORY=false
SD_API_URL=
SD_API_KEY=
